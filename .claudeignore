# --- ADLİ ANALİZ VE VERİ SETLERİ (Kritik: Binlerce dosya var) ---
forensa_dataset/
forensa_train/dataset/
# Eğitim sırasında oluşan geçici veriler
forensa_train/train/
forensa_train/test/

# --- MODELLER VE AĞIR DOSYALAR (GGUF, Safetensors vb.) ---
# Claude bu dosyaları okuyamaz, sadece yer kaplarlar.
models/
llama.cpp/models/
forensa_train/trained_models/
# HuggingFace veya Unsloth tarafından oluşturulan model klasörleri
**/models--*
*.gguf
*.bin
*.pt
*.pth
*.onnx

# --- PYTHON SİSTEM VE BINARY DOSYALARI ---
# Görselde gördüğümüz tüm sistem dosyalarını ignore ediyoruz.
python/
Scripts/
*.exe
*.dll
*.pyd
*.so
*.cat
*.zip

# --- ÇIKTILAR VE LOGLAR ---
# Analiz sonuçları ve loglar bağlamı kirletir.
output/
logs/
forensa_analyze/logs/
*.log
*.csv
*.jsonl

# --- PYTHON CACHE VE IDE ---
__pycache__/
**/*.pyc
.pytest_cache/
.vscode/
.idea/
.git/
.claude/

# --- DİĞER GEÇİCİ DOSYALAR ---
